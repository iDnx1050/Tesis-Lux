# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://tudominio.cl

# ─── Age Gate (requerido en producción) ───────────────────────────────────────
# Obligatorio en producción (mín. 32 bytes). Si falta, el age gate falla cerrado.
# Generar con: openssl rand -base64 32
AGE_GATE_SECRET=

# ─── Logs (sal para hashear la IP en los registros — Ley 21.719) ──────────────
# Debe ser secreta para que el hash de IP no sea reversible. openssl rand -hex 16
IP_HASH_SALT=

# ─── Database (Phase 2 — PostgreSQL + Prisma) ─────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/luxx_db

# ─── Authentication (Phase 2 — NextAuth.js) ───────────────────────────────────
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000

# ─── Payment — Transbank Webpay Plus (Phase 2) ────────────────────────────────
# TRANSBANK_COMMERCE_CODE=your-commerce-code
# TRANSBANK_API_KEY=your-api-key
# TRANSBANK_ENV=integration   # "integration" | "production"

# ─── Email (Phase 2 — Resend recommended) ─────────────────────────────────────
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=noreply@luxxproducciones.cl
# EMAIL_ADMIN=contacto@luxxproducciones.cl

# ─── Rate limiting (Phase 2 — Upstash Redis for multi-instance) ───────────────
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Monitoring ───────────────────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn

# ─── Analytics ────────────────────────────────────────────────────────────────
# Netlify Analytics is server-side and enabled from the Netlify dashboard — no env var needed
