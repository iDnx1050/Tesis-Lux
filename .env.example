# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://tudominio.cl

# ─── Age Gate ─────────────────────────────────────────────────────────────────
# Sin configuración: el aviso de edad es un overlay del lado del cliente
# (components/age-gate.tsx) y ya no usa token firmado ni AGE_GATE_SECRET.

# ─── Google Calendar (cuenta de servicio) ─────────────────────────────────────
# Del JSON de la service account se usan SOLO estos dos campos.
# NUNCA con prefijo NEXT_PUBLIC_: eso publicaría la clave privada en el bundle
# del navegador. El JSON completo no debe entrar nunca al repositorio.
# La clave va entre comillas y con los \n literales (tal como vienen en el JSON);
# el código la desescapa con .replace(/\\n/g, '\n').
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=""
# ID del calendario donde se crean/leen los eventos (Configuración del
# calendario → "ID del calendario"). Recuerda compartir ese calendario con
# GOOGLE_SA_EMAIL, o la cuenta de servicio no verá nada.
GOOGLE_CALENDAR_ID=

# ─── Logs (sal para hashear la IP en los registros — Ley 21.719) ──────────────
# Debe ser secreta para que el hash de IP no sea reversible. openssl rand -hex 16
IP_HASH_SALT=

# ─── Base de datos (PostgreSQL en Neon) ───────────────────────────────────────
# Guarda las órdenes de pago de Webpay. Cadena de conexión de Neon
# (Dashboard → Connect). Sin ella los pagos quedan deshabilitados (503).
# Crear las tablas una vez con: npm run db:setup
DATABASE_URL=

# ─── Authentication (Phase 2 — NextAuth.js) ───────────────────────────────────
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000

# ─── Pagos — Transbank Webpay Plus ────────────────────────────────────────────
# integration (por defecto): ambiente de pruebas de Transbank con sus
#   credenciales públicas; el checkout muestra el aviso de "modo de prueba".
# production: cobros reales. Exige el código de comercio y la llave secreta
#   (Api Key Secret) que entrega Transbank al aprobar la validación.
TRANSBANK_ENV=integration
# Solo para production. NUNCA con prefijo NEXT_PUBLIC_: la llave secreta
# quedaría publicada en el bundle del navegador.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

# ─── Email (Phase 2 — Resend recommended) ─────────────────────────────────────
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=noreply@luxxproducciones.cl
# EMAIL_ADMIN=contacto@luxxproducciones.cl

# ─── Rate limiting (Phase 2 — Upstash Redis for multi-instance) ───────────────
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Monitoring ───────────────────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn

# ─── Analytics ────────────────────────────────────────────────────────────────
# Netlify Analytics is server-side and enabled from the Netlify dashboard — no env var needed
